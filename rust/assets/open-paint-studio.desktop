[Desktop Entry]
Type=Application
Name=Open Paint Studio
GenericName=Raster editor
Comment=Drawing tools in the OpenAEC style, native Rust edition
Exec=@EXEC@ %f
Icon=open-paint-studio
Terminal=false
Categories=Graphics;2DGraphics;RasterGraphics;
MimeType=image/png;image/jpeg;image/webp;image/gif;image/bmp;image/tiff;image/svg+xml;image/x-icon;image/x-tga;image/qoi;image/x-portable-pixmap;image/vnd.radiance;image/x-exr;image/x-dds;
StartupWMClass=open-paint-studio
