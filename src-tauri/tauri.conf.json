{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenAEC Paint Studio",
  "version": "2026.43.2",
  "identifier": "org.openaec.paint-studio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:3020",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenAEC Paint Studio",
        "width": 1440,
        "height": 940,
        "minWidth": 720,
        "minHeight": 560,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:47831; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "Drawing tools in the OpenAEC style",
    "copyright": "OpenAEC contributors. Brand assets: OpenAEC Foundation, CC BY-SA 4.0.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [],
        "files": {
          "/usr/share/mime/packages/openaec-paint-studio.xml": "resources/openaec-paint-studio.xml"
        }
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "png"
        ],
        "mimeType": "image/png",
        "name": "Image",
        "role": "Editor"
      },
      {
        "ext": [
          "jpg",
          "jpeg",
          "jpe",
          "jfif"
        ],
        "mimeType": "image/jpeg",
        "name": "Image",
        "role": "Editor"
      },
      {
        "ext": [
          "webp"
        ],
        "mimeType": "image/webp",
        "name": "Image",
        "role": "Editor"
      },
      {
        "ext": [
          "gif"
        ],
        "mimeType": "image/gif",
        "name": "Image",
        "role": "Editor"
      },
      {
        "ext": [
          "bmp",
          "dib"
        ],
        "mimeType": "image/bmp",
        "name": "Image",
        "role": "Editor"
      },
      {
        "ext": [
          "tif",
          "tiff"
        ],
        "mimeType": "image/tiff",
        "name": "Image",
        "role": "Editor"
      },
      {
        "ext": [
          "svg",
          "svgz"
        ],
        "mimeType": "image/svg+xml",
        "name": "Image",
        "role": "Editor"
      },
      {
        "ext": [
          "avif"
        ],
        "mimeType": "image/avif",
        "name": "Image",
        "role": "Editor"
      },
      {
        "ext": [
          "heic"
        ],
        "mimeType": "image/heic",
        "name": "Image",
        "role": "Editor"
      },
      {
        "ext": [
          "heif"
        ],
        "mimeType": "image/heif",
        "name": "Image",
        "role": "Editor"
      },
      {
        "ext": [
          "ico"
        ],
        "mimeType": "image/vnd.microsoft.icon",
        "name": "Image",
        "role": "Editor"
      },
      {
        "ext": [
          "psd",
          "psb"
        ],
        "mimeType": "image/vnd.adobe.photoshop",
        "name": "Image",
        "role": "Editor"
      },
      {
        "ext": [
          "tga"
        ],
        "mimeType": "image/x-tga",
        "name": "Image",
        "role": "Editor"
      },
      {
        "ext": [
          "jp2"
        ],
        "mimeType": "image/jp2",
        "name": "Image",
        "role": "Editor"
      },
      {
        "ext": [
          "jxl"
        ],
        "mimeType": "image/jxl",
        "name": "Image",
        "role": "Editor"
      },
      {
        "ext": [
          "exr"
        ],
        "mimeType": "image/x-exr",
        "name": "Image",
        "role": "Editor"
      },
      {
        "ext": [
          "dng"
        ],
        "mimeType": "image/x-adobe-dng",
        "name": "Image",
        "role": "Editor"
      },
      {
        "ext": [
          "ifcx"
        ],
        "mimeType": "application/x-ifcx",
        "name": "IFCX document",
        "role": "Editor"
      },
      {
        "ext": [
          "ifcxb"
        ],
        "mimeType": "application/x-ifcxb",
        "name": "IFCX document",
        "role": "Editor"
      }
    ]
  }
}
