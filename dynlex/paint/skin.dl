# The shell's skin: the browser editor's elements as measured, in paint order
# (skin_data.dl, generated by dynlex/tools/shell/make_skin.py). Each entry has
# the condition under which it shows and how its rectangle follows the window.
import dynlex/paint/canvas.dl
import lib/list.dl
import lib/string.dl

function paint skin rectangle:
    replacement: 1
function paint skin image:
    replacement: 2
function paint skin text:
    replacement: 3
function paint skin hit:
    replacement: 4
function paint skin control:
    replacement: 5
# A focus ring on a dialog's button: shown while no field has focus.
function paint skin ring:
    replacement: 6

function paint skin measured width:
    replacement: 1440.0
function paint skin measured height:
    replacement: 940.0

class:
    patterns:
        [a|] paint skin entry
    members:
        kind as an integer
        tab as an integer
        opened as an integer
        closed as an integer
        history as an integer
        row as an integer
        tool as a string
        swatch as a string
        kx as a 64 bit floating-point number
        kw as a 64 bit floating-point number
        ky as a 64 bit floating-point number
        kh as a 64 bit floating-point number
        x as a 64 bit floating-point number
        y as a 64 bit floating-point number
        w as a 64 bit floating-point number
        h as a 64 bit floating-point number
        image as an integer
        face as an integer
        size as an integer
        color as a paint color
        spacing as an integer
        align as an integer
        text as a string
        action as a string

class:
    patterns:
        [a|] paint skin
    members:
        entries as a pointer to a list
        svgs as a pointer to a list

function a new paint skin:
    execute:
        return @intrinsic("construct", a paint skin, an empty list of a paint skin entry, an empty list of a string)

function add svg {C string:markup} to {a pointer to a paint skin:skin}:
    execute:
        append (the string form of markup) to (skin's svgs)

local function the paint color of hex {C string:digits} with alpha:
    execute:
        set solid to the paint color from hex digits
        set high to 0
        set low to 0
        set character to (the character at 6 in digits) as an integer
        if character >= 97:
            set high to character - 87
        else:
            set high to character - 48
        set character to (the character at 7 in digits) as an integer
        if character >= 97:
            set low to character - 87
        else:
            set low to character - 48
        return the paint color red solid's red green solid's green blue solid's blue alpha ((high * 16) + low)

function add kind {integer:kind} when {integer:tab} {integer:opened} {integer:closed} {integer:history} {integer:row} {C string:tool} {C string:swatch} anchored {a 64 bit floating-point number:kx} {a 64 bit floating-point number:kw} {a 64 bit floating-point number:ky} {a 64 bit floating-point number:kh} at {a 64 bit floating-point number:x} {a 64 bit floating-point number:y} {a 64 bit floating-point number:w} {a 64 bit floating-point number:h} showing {integer:image} {integer:face} {integer:size} {C string:color} {integer:spacing} {integer:align} {C string:text} {C string:action} to {a pointer to a paint skin:skin}:
    execute:
        set entry to @intrinsic("construct", a paint skin entry, kind, tab, opened, closed, history, row, the string form of tool, the string form of swatch, kx, kw, ky, kh, x, y, w, h, image, face, size, the paint color of hex color with alpha, spacing, align, the string form of text, the string form of action)
        append entry to (skin's entries)

# --- Conditions ---

class:
    patterns:
        [a|] paint skin state
    members:
        tab as an integer
        opened as an integer
        filled as a boolean
        tool as a string
        swatch as a string
        focused as a boolean
        panelHidden as a boolean

# --- Layout regions, by where the element was measured (1440 x 940) ---
# The browser editor hides the properties panel on request, and in focus
# mode also the ribbon tabs, ribbon and document bar; its workspace then
# grows into the space. Workspace elements are placed as if the window were
# that much larger, which is how their measured anchors describe CSS's
# growing workspace.
function paint skin panel width:
    replacement: 236
function paint skin chrome height:
    replacement: 182

local function the region of {paint skin entry:entry}:
    execute:
        if entry's opened >= 0:
            return 1
        if (entry's y >= 224.0) and (entry's y < 911.0):
            if entry's x >= 1204.0:
                return 3
            return 2
        if (entry's y >= 42.0) and (entry's y < 224.0):
            return 1
        return 0

local function {string:wanted} admits {string:current}:
    execute:
        if wanted's length = 0:
            return true
        if ((the character at 0 in wanted) as an integer) = 33:
            return (the substring of wanted from 1 spanning (wanted's length - 1) bytes = current) = false
        return wanted = current

# Whether the entry shows in the state; row templates show only through the
# history list.
function {paint skin entry:entry} shows in {paint skin state:state}:
    execute:
        if (entry's tab >= 0) and (entry's tab != state's tab):
            return false
        if entry's opened >= 0:
            if entry's opened != state's opened:
                return false
        if (state's opened >= 0) and (((entry's closed >> state's opened) & 1) = 1):
            return false
        if (entry's history = 0) and state's filled:
            return false
        if (entry's history = 1) and (state's filled = false):
            return false
        if entry's row >= 0:
            return false
        if (entry's tool admits state's tool) = false:
            return false
        if (entry's swatch admits state's swatch) = false:
            return false
        set region to the region of entry
        if (region = 3) and (state's panelHidden or state's focused):
            return false
        if (region = 1) and state's focused:
            return false
        return true

# Whether the history rows (in the panel) show.
function the panel shows in {paint skin state:state}:
    execute:
        return (state's panelHidden or state's focused) = false

# --- Geometry: the measured rectangle moved and stretched with the window. ---

class:
    patterns:
        [a|] paint skin box
    members:
        x as an integer
        y as an integer
        w as an integer
        h as an integer
        left as a 64 bit floating-point number
        top as a 64 bit floating-point number

function the box of {paint skin entry:entry} in {integer:width} by {integer:height}:
    execute:
        set dx to (width as a 64 bit floating-point number) - paint skin measured width
        set dy to (height as a 64 bit floating-point number) - paint skin measured height
        set left to entry's x + (entry's kx * dx)
        set top to entry's y + (entry's ky * dy)
        set right to left + (entry's w + (entry's kw * dx))
        set bottom to top + (entry's h + (entry's kh * dy))
        set x to (the rounded value of left) as an integer
        set y to (the rounded value of top) as an integer
        return @intrinsic("construct", a paint skin box, x, y, ((the rounded value of right) as an integer) - x, ((the rounded value of bottom) as an integer) - y, left, top)

# The entry's rectangle in the window and the state's layout.
function the box of {paint skin entry:entry} in {integer:width} by {integer:height} within {paint skin state:state}:
    execute:
        if (the region of entry) != 2:
            return the box of entry in width by height
        set wider to 0
        set taller to 0
        if state's panelHidden or state's focused:
            set wider to paint skin panel width
        if state's focused:
            set taller to paint skin chrome height
        set placed to the box of entry in (width + wider) by (height + taller)
        set placed's y to placed's y - taller
        set placed's top to placed's top - (taller as a 64 bit floating-point number)
        return placed

function {integer:px} {integer:py} lies in {paint skin box:box}:
    execute:
        return ((px >= box's x) and (py >= box's y)) and ((px < (box's x + box's w)) and (py < (box's y + box's h)))
