# --- The codestream (Annex A) ---

# Reads the codestream into the image's component planes: 0 read, 1
# damaged, 2 packed packet headers, 3 more than 16 components, 4 too large.
local function decode jp2 codestream {pointer:stream} spanning {integer:size} into {a pointer to a jp2 image:image}:
    execute:
        if size < 46:
            return 1
        if ((the big-endian half 0 in stream) != 65359) or ((the big-endian half 2 in stream) != 65361):
            return 1
        set siz to the big-endian half 4 in stream
        set components to the big-endian half 40 in stream
        if (components < 1) or (components > jp2 largest components):
            return 3
        if (42 + (3 * components)) > (4 + siz):
            return 1
        set sizes to image's jiSizes
        loop field from 0 to 8:
            set value to the big-endian word (8 + (field * 4)) in stream
            if (value < 0) or (value > 1073741823):
                return 4
            store value at (sizes + field)
        store components at (sizes + 8)
        set image's jiComponents to components
        if (((the item at 0 in sizes) <= (the item at 2 in sizes)) or ((the item at 1 in sizes) <= (the item at 3 in sizes))) or (((the item at 4 in sizes) < 1) or ((the item at 5 in sizes) < 1)):
            return 1
        loop component from 0 to components:
            set packed to the byte (42 + (component * 3)) in stream
            set precision to (packed & 127) + 1
            if precision > 16:
                return 4
            store precision at ((image's jiPrecisions) + component)
            store (packed >> 7) at ((image's jiSigned) + component)
            set dx to the byte (43 + (component * 3)) in stream
            set dy to the byte (44 + (component * 3)) in stream
            if (dx < 1) or (dy < 1):
                return 1
            store dx at ((image's jiSteps) + component)
            store dy at ((image's jiSteps) + (component + components))
            set planeWidth to (the jp2 ceiling of (the item at 0 in sizes) over dx) - (the jp2 ceiling of (the item at 2 in sizes) over dx)
            set planeHeight to (the jp2 ceiling of (the item at 1 in sizes) over dy) - (the jp2 ceiling of (the item at 3 in sizes) over dy)
            store planeWidth at ((image's jiPlaneWidths) + component)
            store planeHeight at ((image's jiPlaneHeights) + component)
            set plane to @intrinsic("call", "libc", "calloc", a pointer to an integer, ((planeWidth * planeHeight) + 1) as a word sized integer, 4 as a word sized integer)
            store (plane as a C long integer) at ((image's jiPlanes) + component)
        set across to the jp2 ceiling of ((the item at 0 in sizes) - (the item at 6 in sizes)) over (the item at 4 in sizes)
        set down to the jp2 ceiling of ((the item at 1 in sizes) - (the item at 7 in sizes)) over (the item at 5 in sizes)
        if (across * down) > 65535:
            return 4
        set tiles to across * down
        set mainArea to @intrinsic("call", "libc", "calloc", a pointer to an integer, jp2 area size as a word sized integer, 4 as a word sized integer)
        set cursor to read jp2 markers from (4 + siz) until size in stream components components into mainArea
        if cursor < 0:
            @intrinsic("call", "libc", "free", nothing, mainArea)
            if cursor = -2:
                return 2
            return 1
        if ((the item at 0 in mainArea) = 0) or ((the item at 697 in mainArea) = 0):
            @intrinsic("call", "libc", "free", nothing, mainArea)
            return 1
        # The tile-parts: their tile, where their data starts and its size.
        set areas to @intrinsic("call", "libc", "calloc", a pointer to a C long integer, (tiles + 1) as a word sized integer, 8 as a word sized integer)
        set parts to a new jp2 list
        set status to 0
        set going to true
        loop while going and ((cursor + 12) <= size):
            if (the big-endian half cursor in stream) != 65424:
                set going to false
            else:
                set lsot to the big-endian half (cursor + 2) in stream
                set tileIndex to the big-endian half (cursor + 4) in stream
                set length to the big-endian word (cursor + 6) in stream
                set finish to size
                if length > 0:
                    set finish to the minimum of (cursor + length) and size
                if (tileIndex >= tiles) or (length < 0):
                    set status to 1
                    set going to false
                else:
                    if (the item at tileIndex in areas) = (0 as a C long integer):
                        set fresh to @intrinsic("call", "libc", "calloc", a pointer to an integer, jp2 area size as a word sized integer, 4 as a word sized integer)
                        store (fresh as a C long integer) at (areas + tileIndex)
                    set ownArea to (the item at tileIndex in areas) as a pointer to an integer
                    set header to read jp2 markers from ((cursor + 2) + lsot) until finish in stream components components into ownArea
                    if header < 0:
                        set status to 1
                        if header = -2:
                            set status to 2
                        set going to false
                    else if (header + 2) > finish:
                        set going to false
                    else if (the big-endian half header in stream) != 65427:
                        set status to 1
                        set going to false
                    else:
                        append tileIndex to jp2 list (the address of parts)
                        append (header + 2) to jp2 list (the address of parts)
                        append (finish - (header + 2)) to jp2 list (the address of parts)
                        set cursor to finish
                        if length = 0:
                            set going to false
        # Each tile from its tile-parts' data joined.
        if status = 0:
            set items to parts' jlItems
            loop tileIndex from 0 to tiles:
                if (the item at tileIndex in areas) != (0 as a C long integer):
                    set total to 0
                    set part to 0
                    loop while part < (parts' jlCount):
                        if (the item at part in items) = tileIndex:
                            set total to total + (the item at (part + 2) in items)
                        set part to part + 3
                    set joined to @intrinsic("call", "libc", "malloc", a pointer to a byte, (total + 8) as a word sized integer)
                    set filled to 0
                    set part to 0
                    loop while part < (parts' jlCount):
                        if (the item at part in items) = tileIndex:
                            ignore @intrinsic("call", "libc", "memcpy", a pointer, joined + filled, (stream as a pointer to a byte) + (the item at (part + 1) in items), (the item at (part + 2) in items) as a word sized integer)
                            set filled to filled + (the item at (part + 2) in items)
                        set part to part + 3
                    ignore decode jp2 tile tileIndex from (joined as pointer) spanning total main mainArea own ((the item at tileIndex in areas) as a pointer to an integer) of image
                    @intrinsic("call", "libc", "free", nothing, joined)
        loop tileIndex from 0 to tiles:
            if (the item at tileIndex in areas) != (0 as a C long integer):
                @intrinsic("call", "libc", "free", nothing, (the item at tileIndex in areas) as a pointer to an integer)
        @intrinsic("call", "libc", "free", nothing, areas)
        @intrinsic("call", "libc", "free", nothing, parts' jlItems)
        @intrinsic("call", "libc", "free", nothing, mainArea)
        return status

# --- The JP2 file (Annex I) and the picture ---

# What the JP2 header says about the channels: the colour space (16 sRGB,
# 17 grey, 18 sYCC, 0 not said), channel definitions (cdef), a palette
# (pclr) and the component mapping (cmap).
class:
    patterns:
        [a|] jp2 channels
    members:
        jcSpace as an integer
        jcDefinitions as a pointer to an integer
        jcDefinitionCount as an integer
        jcPalette as a pointer to an integer
        jcPaletteEntries as an integer
        jcPaletteColumns as an integer
        jcPaletteDepths as a pointer to an integer
        jcMapping as a pointer to an integer
        jcMappingCount as an integer

local function read jp2 header boxes from {integer:start} until {integer:finish} in {pointer:data} into {a pointer to a jp2 channels:channels}:
    execute:
        set at to start
        loop while (at + 8) <= finish:
            set length to the big-endian word at in data
            set body to at + 8
            if length = 0:
                set length to finish - at
            if (length < 8) or ((at + length) > finish):
                return nothing
            set stop to at + length
            if the bytes (at + 4) in data spell "colr":
                if (body + 7) <= stop:
                    if (the byte body in data) = 1:
                        set channels' jcSpace to the big-endian word (body + 3) in data
            else if the bytes (at + 4) in data spell "cdef":
                set count to the minimum of (the big-endian half body in data) and 16
                set channels' jcDefinitionCount to count
                loop entry from 0 to count:
                    if (body + (8 + (entry * 6))) <= stop:
                        store (the big-endian half ((body + 2) + (entry * 6)) in data) at ((channels' jcDefinitions) + (entry * 3))
                        store (the big-endian half ((body + 4) + (entry * 6)) in data) at ((channels' jcDefinitions) + ((entry * 3) + 1))
                        store (the big-endian half ((body + 6) + (entry * 6)) in data) at ((channels' jcDefinitions) + ((entry * 3) + 2))
            else if the bytes (at + 4) in data spell "pclr":
                if (body + 3) <= stop:
                    set entries to the minimum of (the big-endian half body in data) and 1024
                    set columns to the minimum of (the byte (body + 2) in data) and 16
                    set channels' jcPaletteEntries to entries
                    set channels' jcPaletteColumns to columns
                    set channels' jcPalette to @intrinsic("call", "libc", "calloc", a pointer to an integer, ((entries * columns) + 1) as a word sized integer, 4 as a word sized integer)
                    set cursor to body + 3
                    loop column from 0 to columns:
                        store (((the byte cursor in data) & 127) + 1) at ((channels' jcPaletteDepths) + column)
                        set cursor to cursor + 1
                    loop entry from 0 to entries:
                        loop column from 0 to columns:
                            set width to ((the item at column in (channels' jcPaletteDepths)) + 7) / 8
                            set value to 0
                            loop index from 0 to width:
                                if cursor < stop:
                                    set value to (value << 8) | (the byte cursor in data)
                                set cursor to cursor + 1
                            store value at ((channels' jcPalette) + ((entry * columns) + column))
            else if the bytes (at + 4) in data spell "cmap":
                set count to the minimum of ((stop - body) / 4) and 16
                set channels' jcMappingCount to count
                loop entry from 0 to count:
                    store (the big-endian half (body + (entry * 4)) in data) at ((channels' jcMapping) + (entry * 3))
                    store (the byte ((body + 2) + (entry * 4)) in data) at ((channels' jcMapping) + ((entry * 3) + 1))
                    store (the byte ((body + 3) + (entry * 4)) in data) at ((channels' jcMapping) + ((entry * 3) + 2))
            set at to stop

# A channel's sample at a pixel, scaled to eight bits.
local function the jp2 sample of {integer:channel} at {integer:x} {integer:y} in {a pointer to a jp2 image:image} with {a pointer to a jp2 channels:channels}:
    execute:
        set component to channel
        set column to -1
        if (channels' jcMappingCount) > 0:
            set component to the item at (channel * 3) in (channels' jcMapping)
            if (the item at ((channel * 3) + 1) in (channels' jcMapping)) = 1:
                set column to the item at ((channel * 3) + 2) in (channels' jcMapping)
        set components to image's jiComponents
        if component >= components:
            return 0
        set sizes to image's jiSizes
        set dx to the item at component in (image's jiSteps)
        set dy to the item at (component + components) in (image's jiSteps)
        set planeX to (((x + (the item at 2 in sizes)) / dx) - (the jp2 ceiling of (the item at 2 in sizes) over dx)) clamped between 0 and ((the item at component in (image's jiPlaneWidths)) - 1)
        set planeY to (((y + (the item at 3 in sizes)) / dy) - (the jp2 ceiling of (the item at 3 in sizes) over dy)) clamped between 0 and ((the item at component in (image's jiPlaneHeights)) - 1)
        set plane to (the item at component in (image's jiPlanes)) as a pointer to an integer
        set value to the item at ((planeY * (the item at component in (image's jiPlaneWidths))) + planeX) in plane
        set precision to the item at component in (image's jiPrecisions)
        if (column >= 0) and (column < (channels' jcPaletteColumns)):
            set value to the item at (((value clamped between 0 and ((channels' jcPaletteEntries) - 1)) * (channels' jcPaletteColumns)) + column) in (channels' jcPalette)
            set precision to the item at column in (channels' jcPaletteDepths)
        if precision > 8:
            return value >> (precision - 8)
        if precision < 8:
            set largest to (1 << precision) - 1
            return ((value * 255) + (largest / 2)) / largest
        return value

function the paint jp2 from {pointer:data} spanning {integer:count}:
    execute:
        set start to 0
        set size to count
        set definitions to @intrinsic("call", "libc", "calloc", a pointer to an integer, 48 as a word sized integer, 4 as a word sized integer)
        set mapping to @intrinsic("call", "libc", "calloc", a pointer to an integer, 48 as a word sized integer, 4 as a word sized integer)
        set depths to @intrinsic("call", "libc", "calloc", a pointer to an integer, 16 as a word sized integer, 4 as a word sized integer)
        set described to @intrinsic("construct", a jp2 channels, 0, definitions, 0, 0 as a pointer to an integer, 0, 0, depths, mapping, 0)
        if count >= 12:
            if the bytes 4 in data spell "jP  ":
                set start to -1
                set at to 0
                loop while (at + 8) <= count:
                    set length to the big-endian word at in data
                    set header to 8
                    if length = 1:
                        set length to the big-endian word (at + 12) in data
                        set header to 16
                    if (length = 0) or ((at + length) > count):
                        set length to count - at
                    if length < header:
                        set length to count - at
                    if the bytes (at + 4) in data spell "jp2h":
                        read jp2 header boxes from (at + 8) until (at + length) in data into (the address of described)
                    else if the bytes (at + 4) in data spell "jp2c":
                        if start < 0:
                            set start to at + header
                            set size to length - header
                    set at to at + length
                if start < 0:
                    return no decoded image because "the JP2 file holds no codestream"
        set components to jp2 largest components
        set image to @intrinsic("construct", a jp2 image, data as a pointer to a byte, 0, @intrinsic("call", "libc", "calloc", a pointer to an integer, 16 as a word sized integer, 4 as a word sized integer), @intrinsic("call", "libc", "calloc", a pointer to an integer, components as a word sized integer, 4 as a word sized integer), @intrinsic("call", "libc", "calloc", a pointer to an integer, components as a word sized integer, 4 as a word sized integer), @intrinsic("call", "libc", "calloc", a pointer to an integer, (components * 2) as a word sized integer, 4 as a word sized integer), @intrinsic("call", "libc", "calloc", a pointer to a C long integer, components as a word sized integer, 8 as a word sized integer), @intrinsic("call", "libc", "calloc", a pointer to an integer, components as a word sized integer, 4 as a word sized integer), @intrinsic("call", "libc", "calloc", a pointer to an integer, components as a word sized integer, 4 as a word sized integer), @intrinsic("call", "libc", "calloc", a pointer to an integer, 200 as a word sized integer, 4 as a word sized integer), a jp2 zero context table)
        fill jp2 numbers (image's jiTable) from (the jp2 probability states)
        set status to decode jp2 codestream (((data as a pointer to a byte) + start) as pointer) spanning size into (the address of image)
        set result to no decoded image because "the JPEG 2000 data is damaged"
        if status = 2:
            set result to no decoded image because "a JPEG 2000 file with packed packet headers, which the editor does not read yet"
        else if status = 3:
            set result to no decoded image because "a JPEG 2000 file with more than 16 components"
        else if status = 4:
            set result to no decoded image because "the JPEG 2000 image is larger than the editor can use"
        else if status = 0:
            set sizes to image's jiSizes
            set width to (the item at 0 in sizes) - (the item at 2 in sizes)
            set height to (the item at 1 in sizes) - (the item at 3 in sizes)
            if (a paint canvas width by height fits) = false:
                set result to no decoded image because "the JPEG 2000 image is larger than the editor can use"
            else:
                # The channels' roles: colour channels, then alpha.
                set channelCount to image's jiComponents
                if (described's jcMappingCount) > 0:
                    set channelCount to described's jcMappingCount
                set colours to 3
                if (described's jcSpace) = 17:
                    set colours to 1
                else if ((described's jcSpace) = 0) and (channelCount <= 2):
                    set colours to 1
                set colours to the minimum of colours and channelCount
                set roles to @intrinsic("call", "libc", "calloc", a pointer to an integer, 4 as a word sized integer, 4 as a word sized integer)
                loop role from 0 to 4:
                    store -1 at (roles + role)
                loop role from 0 to colours:
                    store role at (roles + role)
                if channelCount > colours:
                    store colours at (roles + 3)
                set premultiplied to false
                if (described's jcDefinitionCount) > 0:
                    store -1 at (roles + 3)
                    loop entry from 0 to (described's jcDefinitionCount):
                        set channel to the item at (entry * 3) in definitions
                        set kind to the item at ((entry * 3) + 1) in definitions
                        set association to the item at ((entry * 3) + 2) in definitions
                        if (kind = 0) and ((association >= 1) and (association <= colours)):
                            store channel at (roles + (association - 1))
                        else if (kind = 1) or (kind = 2):
                            store channel at (roles + 3)
                            set premultiplied to kind = 2
                set canvas to an unfilled paint canvas width by height
                set out to (canvas's pixels) as a pointer to an integer
                # sYCC as the colour box says, or (as other readers assume) when
                # no colour space is given and the chroma is subsampled.
                set luminance to (described's jcSpace) = 18
                if ((described's jcSpace) = 0) and ((colours = 3) and ((image's jiComponents) >= 3)):
                    set steps to image's jiSteps
                    set components to image's jiComponents
                    if ((the item at 1 in steps) > (the item at 0 in steps)) or ((the item at (1 + components) in steps) > (the item at components in steps)):
                        set luminance to true
                loop y from 0 to height:
                    loop x from 0 to width:
                        set red to the jp2 sample of (the item at 0 in roles) at x y in (the address of image) with (the address of described)
                        set green to red
                        set blue to red
                        if colours = 3:
                            set green to the jp2 sample of (the item at 1 in roles) at x y in (the address of image) with (the address of described)
                            set blue to the jp2 sample of (the item at 2 in roles) at x y in (the address of image) with (the address of described)
                            if luminance:
                                set luma to red
                                set cb to green - 128
                                set cr to blue - 128
                                set red to (luma + (((cr * 91881) + 32768) >> 16)) clamped between 0 and 255
                                set green to (luma - ((((cb * 22554) + (cr * 46802)) + 32768) >> 16)) clamped between 0 and 255
                                set blue to (luma + (((cb * 116130) + 32768) >> 16)) clamped between 0 and 255
                        set alpha to 255
                        if (the item at 3 in roles) >= 0:
                            set alpha to the jp2 sample of (the item at 3 in roles) at x y in (the address of image) with (the address of described)
                            if premultiplied and (alpha > 0):
                                set red to ((red * 255) / alpha) clamped between 0 and 255
                                set green to ((green * 255) / alpha) clamped between 0 and 255
                                set blue to ((blue * 255) / alpha) clamped between 0 and 255
                        store (((red | (green << 8)) | (blue << 16)) | (alpha << 24)) at (out + ((y * width) + x))
                @intrinsic("call", "libc", "free", nothing, roles)
                set result to a decoded canvas
        loop component from 0 to (image's jiComponents):
            @intrinsic("call", "libc", "free", nothing, (the item at component in (image's jiPlanes)) as a pointer to an integer)
        @intrinsic("call", "libc", "free", nothing, image's jiSizes)
        @intrinsic("call", "libc", "free", nothing, image's jiPrecisions)
        @intrinsic("call", "libc", "free", nothing, image's jiSigned)
        @intrinsic("call", "libc", "free", nothing, image's jiSteps)
        @intrinsic("call", "libc", "free", nothing, image's jiPlanes)
        @intrinsic("call", "libc", "free", nothing, image's jiPlaneWidths)
        @intrinsic("call", "libc", "free", nothing, image's jiPlaneHeights)
        @intrinsic("call", "libc", "free", nothing, image's jiTable)
        @intrinsic("call", "libc", "free", nothing, image's jiZero)
        @intrinsic("call", "libc", "free", nothing, definitions)
        @intrinsic("call", "libc", "free", nothing, mapping)
        @intrinsic("call", "libc", "free", nothing, depths)
        if (described's jcPaletteEntries) > 0:
            @intrinsic("call", "libc", "free", nothing, described's jcPalette)
        return result
