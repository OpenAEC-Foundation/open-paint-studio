local function {integer:character} is xpm space:
    execute:
        return ((character = 32) or (character = 9)) or ((character = 10) or (character = 13))

local function {string:word} is an xpm key:
    execute:
        return ((word = (the string form of "c")) or (word = (the string form of "m"))) or (((word = (the string form of "s")) or (word = (the string form of "g"))) or (word = (the string form of "g4")))

# A named X11 colour the XPM files here use, or -1.
local function the named colour {string:name}:
    execute:
        set lower to the lower case of name
        if lower = (the string form of "black"):
            return 0
        if lower = (the string form of "white"):
            return 16777215
        if lower = (the string form of "red"):
            return 16711680
        if (lower = (the string form of "green")) or (lower = (the string form of "lime")):
            return 65280
        if lower = (the string form of "blue"):
            return 255
        if lower = (the string form of "yellow"):
            return 16776960
        if lower = (the string form of "cyan"):
            return 65535
        if lower = (the string form of "magenta"):
            return 16711935
        if (lower = (the string form of "gray")) or (lower = (the string form of "grey")):
            return 12500670
        if (lower = (the string form of "darkgray")) or (lower = (the string form of "darkgrey")):
            return 11119017
        if (lower = (the string form of "lightgray")) or (lower = (the string form of "lightgrey")):
            return 13882323
        if lower = (the string form of "orange"):
            return 16753920
        if lower = (the string form of "brown"):
            return 10824234
        if lower = (the string form of "navy"):
            return 128
        # grayN / greyN, N percent.
        if (lower's length > 4) and ((lower has (the string form of "gray") at offset 0) or (lower has (the string form of "grey") at offset 0)):
            set percent to 0
            loop index from 4 to lower's length:
                set percent to (percent * 10) + ((((the character at index in lower) as an integer) & 255) - 48)
            set level to ((percent * 255) + 50) / 100
            return ((level << 16) | (level << 8)) | level
        return -1

local function the lower case of {string:text}:
    execute:
        set result to a new string buffer containing (text's length) bytes
        loop index from 0 to text's length:
            set character to ((the character at index in text) as an integer) & 255
            if (character >= 65) and (character <= 90):
                set character to character + 32
            store (character as a byte) at ((the data of result) + index)
        return result

# The colour of an XPM colour line's "c" key (the "m" key when there is no
# "c"): None, #rgb in 3 to 12 digits, or a colour name.
local function the xpm colour of {string:spec}:
    execute:
        # Split into words.
        set words to an empty list of a string
        set cursor to 0
        loop while cursor < spec's length:
            loop while (cursor < spec's length) and ((((the character at cursor in spec) as an integer) & 255) is xpm space):
                set cursor to cursor + 1
            set start to cursor
            loop while (cursor < spec's length) and (((((the character at cursor in spec) as an integer) & 255) is xpm space) = false):
                set cursor to cursor + 1
            if cursor > start:
                append (the substring of spec from start spanning (cursor - start) bytes) to words
        set value to the string form of ""
        set fallback to the string form of ""
        set index to 0
        loop while (index + 1) < (the length of words):
            set key to the item at index in words
            if (key = (the string form of "c")) or (key = (the string form of "m")):
                # A name may run over several words, up to the next key.
                set next to index + 2
                set joined to the item at (index + 1) in words
                # ("and" evaluates both sides: the bound is checked first.)
                set going to true
                loop while going:
                    if next >= (the length of words):
                        set going to false
                    else if (the item at next in words) is an xpm key:
                        set going to false
                    else:
                        set joined to joined + (the item at next in words)
                        set next to next + 1
                if key = (the string form of "c"):
                    set value to joined
                else:
                    set fallback to joined
                set index to next
            else:
                set index to index + 2
