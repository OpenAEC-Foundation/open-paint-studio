# rav1e av1_iadst4.
function av1 iadst4 from {a pointer to an integer:input} into {a pointer to an integer:output} within {integer:low} {integer:high}:
    execute:
        set tx0 to (the item at 0 in input)
        set tx1 to (the item at 1 in input)
        set tx2 to (the item at 2 in input)
        set tx3 to (the item at 3 in input)
        set ts0 to (1321 * tx0)
        set ts1 to (2482 * tx0)
        set ts2 to (3344 * tx1)
        set ts3 to (3803 * tx2)
        set ts4 to (1321 * tx2)
        set ts5 to (2482 * tx3)
        set ts6 to (3803 * tx3)
        set ts7 to ((tx0 - tx2) + tx3)
        set ts0 to (ts0 + ts3)
        set ts1 to (ts1 - ts4)
        set ts3 to ts2
        set ts2 to (3344 * ts7)
        set ts0 to (ts0 + ts5)
        set ts1 to (ts1 - ts6)
        set tx0 to (ts0 + ts3)
        set tx1 to (ts1 + ts3)
        set tx2 to ts2
        set tx3 to (ts0 + ts1)
        set tx3 to (tx3 - ts3)
        store (av1 round tx0 by 12) at (output + 0)
        store (av1 round tx1 by 12) at (output + 1)
        store (av1 round tx2 by 12) at (output + 2)
        store (av1 round tx3 by 12) at (output + 3)

