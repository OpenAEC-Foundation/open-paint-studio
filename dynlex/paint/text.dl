# The text tool: renders FreeType glyph coverage into the canvas pixels. The
# face is one of the typesetter's (paint/typeset.dl), which also sets the
# interface's own text.
import dynlex/paint/typeset.dl

# FT_LOAD_RENDER: rasterises the glyph's eight-bit coverage bitmap.
local function freetype render:
    replacement: 4

class:
    patterns:
        [a|] paint code point
    members:
        value as an integer
        size as an integer

# The Unicode code point that starts at index in the UTF-8 text, and how many
# bytes it takes; a malformed byte stands for itself.
function the code point at {integer:index} in {string:message}:
    execute:
        set first to ((the character at index in message) as an integer) & 255
        set count to 1
        set value to first
        if (first >= 240) and ((index + 3) < message's length):
            set count to 4
            set value to first & 7
        else if (first >= 224) and ((index + 2) < message's length):
            set count to 3
            set value to first & 15
        else if (first >= 192) and ((index + 1) < message's length):
            set count to 2
            set value to first & 31
        if count > 1:
            loop step from 1 to count:
                set value to (value << 6) + (((the character at (index + step) in message) as an integer) & 63)
        return @intrinsic("construct", a paint code point, value, count)

# Renders the text into the canvas with its baseline at (x, y), each pixel
# composited from base at the glyph's coverage times the opacity, so a live
# preview can be redrawn on every keystroke. Returns the advance in pixels.
function render {string:message} into {paint canvas:image} from {paint canvas:base} at {integer:x} {integer:y} sized {integer:size} in {paint color:color} at opacity {integer:opacity} with {a pointer to a paint face:typeface}:
    execute:
        use typeface at size pixels
        set pen to x
        set index to 0
        loop while index < message's length:
            set point to the code point at index in message
            set index to index + point's size
            set error to @intrinsic("call", "freetype", "FT_Load_Char", an integer, typeface's face, point's value as a C long integer, freetype render)
            if error = 0:
                set slot to (the glyph of (typeface's face as a pointer to an FT face)) as a pointer to an FT glyph slot
                set rows to the bitmap rows of slot
                set columns to the bitmap width of slot
                set pitch to the bitmap pitch of slot
                set coverage to the bitmap buffer of slot
                set left to pen + (the bitmap left of slot)
                set top to y - (the bitmap top of slot)
                loop row from 0 to rows:
                    loop column from 0 to columns:
                        set amount to ((the item at ((row * pitch) + column) in coverage) as an integer) & 255
                        if amount > 0:
                            set px to left + column
                            set py to top + row
                            if px py lies on image:
                                put (color over (the paint color at px py in base) at opacity ((amount * opacity) / 255)) at px py in image
                set pen to pen + (((the advance x of slot) / 64) as an integer)
        return pen - x
