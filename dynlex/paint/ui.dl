# The OpenAEC application shell around the canvas: title bar, ribbon tabs,
# ribbon, workspace, properties panel and status bar, as the browser editor
# lays them out. Drawing is immediate: every frame draws the whole state, and
# a button reports its command when the frame's click falls inside it.
import dynlex/paint/app.dl

class:
    patterns:
        [a|] paint theme
    members:
        title as a paint color
        bar as a paint color
        docbar as a paint color
        surface as a paint color
        workspace as a paint color
        text as a paint color
        muted as a paint color
        accent as a paint color
        accentText as a paint color
        border as a paint color
        hover as a paint color
        active as a paint color

local function {paint color:first} mixed with {paint color:second} at {integer:percent}:
    execute:
        set keep to 100 - percent
        return the paint color red (((first's red * keep) + (second's red * percent)) / 100) green (((first's green * keep) + (second's green * percent)) / 100) blue (((first's blue * keep) + (second's blue * percent)) / 100)

# The theme tokens of themes.css: light, Forge, Blueprint and high contrast.
function the paint theme numbered {integer:number}:
    execute:
        set background to the paint color from hex "fafaf9"
        set text to the paint color from hex "36363e"
        set accent to the paint color from hex "d97706"
        set title to the paint color from hex "36363e"
        set docbar to the paint color from hex "f5f5f4"
        set surface to the paint color from hex "ffffff"
        set workspace to the paint color from hex "e7e5e4"
        set accentText to the paint color from hex "ffffff"
        if number = 1:
            set background to the paint color from hex "36363e"
            set text to the paint color from hex "fafaf9"
            set title to the paint color from hex "2e2e36"
            set docbar to the paint color from hex "2e2e36"
            set surface to the paint color from hex "44444c"
            set workspace to the paint color from hex "26262c"
            set accentText to the paint color from hex "36363e"
        else if number = 2:
            set background to the paint color from hex "0f1b2d"
            set text to the paint color from hex "e0e7ff"
            set accent to the paint color from hex "60a5fa"
            set title to the paint color from hex "0a1320"
            set docbar to the paint color from hex "0a1320"
            set surface to the paint color from hex "1a2c45"
            set workspace to the paint color from hex "081019"
            set accentText to the paint color from hex "0f1b2d"
        else if number = 3:
            set background to the paint color from hex "000000"
            set text to the paint color from hex "ffffff"
            set accent to the paint color from hex "ffd700"
            set title to the paint color from hex "000000"
            set docbar to the paint color from hex "000000"
            set surface to the paint color from hex "0a0a0a"
            set workspace to the paint color from hex "000000"
            set accentText to the paint color from hex "000000"
        set muted to text mixed with background at 40
        set border to text mixed with background at 85
        if number = 3:
            set border to accent
            set muted to text
        set hover to background mixed with accent at 10
        set active to background mixed with accent at 18
        return @intrinsic("construct", a paint theme, title, background, docbar, surface, workspace, text, muted, accent, accentText, border, hover, active)

function the name of theme {integer:number} for {app}:
    execute:
        if number = 1:
            return label "Forge" "Forge" for app
        if number = 2:
            return label "Blueprint" "Blueprint" for app
        if number = 3:
            return label "High contrast" "Hoog contrast" for app
        return label "Light" "Licht" for app

class:
    patterns:
        [a|] paint ui
    members:
        frame as a graphics frame
        typeface as a font
        theme as a paint theme
        mouseX as an integer
        mouseY as an integer
        clicked as a boolean
        command as an integer
        dutch as a boolean

function a paint ui in {graphics frame:frame} with {font:typeface} for {paint app:app} at {integer:x} {integer:y} clicked {boolean:clicked}:
    execute:
        return @intrinsic("construct", a paint ui, frame, typeface, the paint theme numbered app's theme, x, y, clicked, paint no command, app's dutch)

# --- Layout: the chrome's fixed sizes, in screen pixels ---

function paint title height:
    replacement: 40
function paint tab height:
    replacement: 34
function paint ribbon height:
    replacement: 112
function paint status height:
    replacement: 28
function paint panel width:
    replacement: 260

function the workspace top for {paint app:app}:
    execute:
        if app's focus:
            return paint title height
        return (paint title height + paint tab height) + paint ribbon height

function the workspace right of {integer:width} for {paint app:app}:
    execute:
        if app's focus:
            return width
        return width - paint panel width

# --- Primitives ---

# The runtime presents to an sRGB swapchain but takes colours and textures as
# linear values, so every sRGB colour is decoded to linear light first.
function the linear channel of {integer:value}:
    execute:
        set unit to (value as a 64 bit floating-point number) / 255.0
        if unit <= 0.04045:
            set unit to unit / 12.92
        else:
            set unit to ((unit + 0.055) / 1.055) raised to the power of 2.4
        return ((the rounded value of (unit * 255.0)) as an integer) clamped between 0 and 255

function the linear form of {paint color:color}:
    execute:
        return the paint color red (the linear channel of color's red) green (the linear channel of color's green) blue (the linear channel of color's blue)

function fill {a number:x} {a number:y} {a number:w} {a number:h} with {paint color:color} in {a pointer to a paint ui:ui}:
    execute:
        if (w > 0) and (h > 0):
            set linear to the linear form of color
            draw a rectangle at x x and y y with width w and height h in color red linear's red, green linear's green and blue linear's blue in ui's frame

function outline {a number:x} {a number:y} {a number:w} {a number:h} with {paint color:color} in {a pointer to a paint ui:ui}:
    execute:
        fill x y w 1 with color in ui
        fill x ((y + h) - 1) w 1 with color in ui
        fill x y 1 h with color in ui
        fill ((x + w) - 1) y 1 h with color in ui

# Text with its baseline at y.
function show {string:message} at {a number:x} {a number:y} sized {integer:size} in {paint color:color} in {a pointer to a paint ui:ui}:
    execute:
        use ui's typeface at size pixel size
        set linear to the linear form of color
        write message at x y in red linear's red green linear's green blue linear's blue with ui's typeface in ui's frame

function show {C string:message} at {a number:x} {a number:y} sized {integer:size} in {paint color:color} in {a pointer to a paint ui:ui}:
    execute:
        show (the string form of message) at x y sized size in color in ui

function the width of {string:message} sized {integer:size} in {a pointer to a paint ui:ui}:
    execute:
        use ui's typeface at size pixel size
        return the width of message in ui's typeface

# Text wrapped at spaces to fit width; returns the y below the last line.
function show {string:message} wrapped to {integer:width} at {integer:x} {integer:y} sized {integer:size} in {paint color:color} in {a pointer to a paint ui:ui}:
    execute:
        set baseline to y
        set line to the string form of ""
        set word to the string form of ""
        loop index from 0 to (message's length + 1):
            set ending to index = message's length
            set character to 32
            if ending = false:
                set character to ((the character at index in message) as an integer) & 255
            if character = 32:
                set candidate to word
                if line's length > 0:
                    set candidate to (line + (the string form of " ")) + word
                if ((the width of candidate sized size in ui) > width) and (line's length > 0):
                    show line at x baseline sized size in color in ui
                    set baseline to baseline + (size + 6)
                    set line to word
                else:
                    set line to candidate
                set word to the string form of ""
            else:
                set word to word + (the substring of message from index spanning 1 byte)
        if line's length > 0:
            show line at x baseline sized size in color in ui
            set baseline to baseline + (size + 6)
        return baseline

function {a pointer to a paint ui:ui} hovers {integer:x} {integer:y} {integer:w} {integer:h}:
    execute:
        return ((ui's mouseX >= x) and (ui's mouseX < (x + w))) and ((ui's mouseY >= y) and (ui's mouseY < (y + h)))

# A ribbon button; returns its width so rows can be laid out left to right.
function button {string:caption} at {integer:x} {integer:y} height {integer:h} active {boolean:active} command {integer:command} in {a pointer to a paint ui:ui}:
    execute:
        set w to (the width of caption sized 12 in ui) + 18
        set theme to ui's theme
        if active:
            fill x y w h with theme's active in ui
            outline x y w h with (theme's active mixed with theme's accent at 50) in ui
        else if ui hovers x y w h:
            fill x y w h with theme's hover in ui
        set color to theme's text
        if active:
            set color to theme's accent
        show caption at (x + 9) ((y + (h / 2)) + 4) sized 12 in color in ui
        if ui's clicked and (ui hovers x y w h):
            set ui's command to command
        return w

# A large button with a pictogram letter above its caption, as Open and
# Export in the Project group.
function large button {string:caption} marked {C string:mark} at {integer:x} {integer:y} command {integer:command} in {a pointer to a paint ui:ui}:
    execute:
        set w to (the maximum of (the width of caption sized 12 in ui) and 32) + 20
        set theme to ui's theme
        if ui hovers x y w 72:
            fill x y w 72 with theme's hover in ui
        set markWidth to the width of (the string form of mark) sized 22 in ui
        show mark at (x + ((w - markWidth) / 2)) (y + 34) sized 22 in theme's accent in ui
        show caption at (x + 10) (y + 60) sized 12 in theme's text in ui
        if ui's clicked and (ui hovers x y w 72):
            set ui's command to command
        return w

# A group's caption under its buttons and the divider to its right.
function close group {string:caption} from {integer:left} to {integer:right} in {a pointer to a paint ui:ui}:
    execute:
        set top to paint title height + paint tab height
        set captionWidth to the width of caption sized 11 in ui
        show caption at (left + (((right - left) - captionWidth) / 2)) (top + 104) sized 11 in ui's theme's muted in ui
        fill (right + 8) (top + 8) 1 (paint ribbon height - 16) with ui's theme's border in ui
        return right + 17

# --- The chrome ---

function draw the title bar of {paint app:app} {integer:width} in {a pointer to a paint ui:ui}:
    execute:
        set theme to ui's theme
        fill 0 0 width paint title height with theme's title in ui
        fill 0 0 width 3 with theme's accent in ui
        set light to the paint color from hex "fafaf9"
        fill 14 12 18 18 with theme's accent in ui
        fill 18 16 10 10 with theme's title in ui
        show "Open" at 42 27 sized 15 in light in ui
        set openWidth to the width of (the string form of "Open") sized 15 in ui
        show "AEC" at (42 + openWidth) 27 sized 15 in theme's accent in ui
        set aecWidth to the width of (the string form of "AEC") sized 15 in ui
        show "Paint Studio" at ((50 + openWidth) + aecWidth) 27 sized 13 in light in ui
        set quick to (((62 + openWidth) + aecWidth) + (the width of (the string form of "Paint Studio") sized 13 in ui)) + 16
        fill (quick - 10) 12 1 18 with (theme's title mixed with light at 30) in ui
        set saved to label "Save" "Opslaan" for app
        set undone to label "Undo" "Ongedaan" for app
        set redone to label "Redo" "Opnieuw" for app
        set x to quick
        set x to x + (title button saved at x command paint save command in ui)
        set x to x + (title button undone at x command paint undo command in ui)
        set x to x + (title button redone at x command paint redo command in ui)
        set name to label "untitled" "naamloos" for app
        if app's path's length > 0:
            set name to app's path
        if app's changed:
            set name to name + (the string form of "  •")
        set nameWidth to the width of name sized 12 in ui
        show name at ((width - nameWidth) / 2) 25 sized 12 in light in ui
        set version to the string form of "2026.43.2 · DynLex"
        show version at ((width - (the width of version sized 11 in ui)) - 16) 25 sized 11 in (theme's title mixed with light at 60) in ui

function title button {string:caption} at {integer:x} command {integer:command} in {a pointer to a paint ui:ui}:
    execute:
        set w to (the width of caption sized 11 in ui) + 14
        set light to the paint color from hex "fafaf9"
        if ui hovers x 8 w 24:
            fill x 8 w 24 with (ui's theme's title mixed with light at 15) in ui
        show caption at (x + 7) 24 sized 11 in light in ui
        if ui's clicked and (ui hovers x 8 w 24):
            set ui's command to command
        return w + 2

function draw the tabs of {paint app:app} {integer:width} in {a pointer to a paint ui:ui}:
    execute:
        set theme to ui's theme
        set top to paint title height
        fill 0 top width paint tab height with theme's bar in ui
        fill 0 ((top + paint tab height) - 1) width 1 with theme's border in ui
        set file to label "File" "Bestand" for app
        set fileWidth to (the width of file sized 13 in ui) + 36
        set fileColor to theme's accent
        if app's tab = 3:
            set fileColor to theme's accent mixed with theme's text at 20
        fill 16 (top + 4) fileWidth (paint tab height - 4) with fileColor in ui
        show file at 34 (top + 23) sized 13 in theme's accentText in ui
        if ui's clicked and (ui hovers 16 (top + 4) fileWidth (paint tab height - 4)):
            set ui's command to paint first tab command + 3
        set x to (16 + fileWidth) + 6
        set x to x + (tab (label "Home" "Start" for app) at x numbered paint home tab for app in ui)
        set x to x + (tab (label "Image" "Afbeelding" for app) at x numbered paint image tab for app in ui)
        set x to x + (tab (label "View" "Beeld" for app) at x numbered paint view tab for app in ui)
        set motto to the string form of "Build free. Build together."
        show motto at ((width - (the width of motto sized 11 in ui)) - 16) (top + 22) sized 11 in theme's accent in ui

function tab {string:caption} at {integer:x} numbered {integer:number} for {paint app:app} in {a pointer to a paint ui:ui}:
    execute:
        set theme to ui's theme
        set top to paint title height
        set w to (the width of caption sized 13 in ui) + 36
        if app's tab = number:
            fill x (top + 4) w (paint tab height - 4) with theme's surface in ui
            fill x ((top + paint tab height) - 3) w 3 with theme's accent in ui
        else if ui hovers x (top + 4) w (paint tab height - 4):
            fill x (top + 4) w (paint tab height - 4) with theme's hover in ui
        show caption at (x + 18) (top + 23) sized 13 in theme's text in ui
        if ui's clicked and (ui hovers x (top + 4) w (paint tab height - 4)):
            set ui's command to paint first tab command + number
        return w

local function the percent {integer:value}:
    execute:
        return (the string form of value) + (the string form of " %")

local function a stepper {string:caption} showing {string:value} at {integer:x} {integer:y} lowering {integer:lower} raising {integer:raise} in {a pointer to a paint ui:ui}:
    execute:
        set theme to ui's theme
        show caption at x (y + 17) sized 11 in theme's muted in ui
        set left to x + 74
        ignore button (the string form of "−") at left y height 24 active false command lower in ui
        fill (left + 30) y 54 24 with theme's surface in ui
        outline (left + 30) y 54 24 with theme's border in ui
        show value at (left + 38) (y + 17) sized 12 in theme's text in ui
        ignore button (the string form of "+") at (left + 88) y height 24 active false command raise in ui
        return 196

function draw the home ribbon of {paint app:app} in {a pointer to a paint ui:ui}:
    execute:
        set top to (paint title height + paint tab height) + 6
        set theme to ui's theme
        # Project
        set x to 16
        set start to x
        set x to x + (large button (label "Open" "Openen" for app) marked "▤" at x top command paint open command in ui)
        set x to x + (large button (label "Export PNG" "PNG exporteren" for app) marked "⇩" at x top command paint save as command in ui)
        set x to close group (label "Project" "Project" for app) from start to x in ui
        # Tools
        set start to x
        set row to x
        set row to row + (button (the name of tool paint brush tool for app) at row top height 26 active (app's tool = paint brush tool) command paint brush tool in ui)
        set row to row + (button (the name of tool paint eraser tool for app) at row top height 26 active (app's tool = paint eraser tool) command paint eraser tool in ui)
        set row to row + (button (the name of tool paint fill tool for app) at row top height 26 active (app's tool = paint fill tool) command paint fill tool in ui)
        set row to row + (button (the name of tool paint picker tool for app) at row top height 26 active (app's tool = paint picker tool) command paint picker tool in ui)
        set widest to row
        set row to x
        set row to row + (button (the name of tool paint line tool for app) at row (top + 30) height 26 active (app's tool = paint line tool) command paint line tool in ui)
        set row to row + (button (the name of tool paint rectangle tool for app) at row (top + 30) height 26 active (app's tool = paint rectangle tool) command paint rectangle tool in ui)
        set row to row + (button (the name of tool paint ellipse tool for app) at row (top + 30) height 26 active (app's tool = paint ellipse tool) command paint ellipse tool in ui)
        set row to row + (button (the name of tool paint text tool for app) at row (top + 30) height 26 active (app's tool = paint text tool) command paint text tool in ui)
        set widest to the maximum of widest and row
        set mark to the string form of "☐  "
        if app's filled:
            set mark to the string form of "☑  "
        ignore button (mark + (label "Filled shape" "Gevulde vorm" for app)) at x (top + 62) height 24 active false command paint filled command in ui
        set x to close group (label "Tools" "Gereedschap" for app) from start to widest in ui
        # Properties
        set start to x
        set sizeValue to (the string form of app's size) + (the string form of " px")
        if app's tool = paint text tool:
            set sizeValue to (the string form of app's textSize) + (the string form of " px")
        ignore a stepper (label "Size" "Grootte" for app) showing sizeValue at x (top + 4) lowering paint smaller command raising paint larger command in ui
        ignore a stepper (label "Opacity" "Dekking" for app) showing (the percent app's opacity) at x (top + 36) lowering paint fainter command raising paint stronger command in ui
        set x to close group (label "Properties" "Eigenschappen" for app) from start to (x + 196) in ui
        # Colors
        set start to x
        fill x (top + 6) 34 60 with app's color in ui
        outline x (top + 6) 34 60 with theme's border in ui
        set palette to the paint palette
        loop index from 0 to the length of palette:
            set swatch to the item at index in palette
            set sx to (x + 46) + ((the remainder of index divided by 10) * 22)
            set sy to (top + 4) + ((index / 10) * 22)
            fill sx sy 18 18 with swatch in ui
            if paint colors swatch and app's color are equal:
                outline (sx - 2) (sy - 2) 22 22 with theme's accent in ui
            else:
                outline sx sy 18 18 with theme's border in ui
            if ui's clicked and (ui hovers sx sy 18 18):
                set ui's command to paint first swatch command + index
        free palette
        set x to close group (label "Colors" "Kleuren" for app) from start to (x + 264) in ui
        # View
        set start to x
        set column to x
        ignore button (label "Fit to window" "Passend maken" for app) at column top height 26 active false command paint fit command in ui
        ignore button (label "Grid" "Raster" for app) at column (top + 30) height 26 active app's grid command paint grid command in ui
        ignore button (label "Focus mode" "Focusmodus" for app) at column (top + 60) height 26 active app's focus command paint focus command in ui
        ignore close group (label "View" "Beeld" for app) from start to (x + 120) in ui

function draw the image ribbon of {paint app:app} in {a pointer to a paint ui:ui}:
    execute:
        set top to (paint title height + paint tab height) + 6
        set x to 16
        set start to x
        set row to x
        set row to row + (button (label "Crop" "Bijsnijden" for app) at row top height 26 active (app's tool = paint crop tool) command paint crop tool in ui)
        set row to row + (button (label "Resize 50 %" "Formaat 50 %" for app) at row top height 26 active false command paint half size command in ui)
        set row to row + (button (label "Resize 200 %" "Formaat 200 %" for app) at row top height 26 active false command paint double size command in ui)
        set widest to row
        set row to x
        set row to row + (button (label "Rotate left" "Links draaien" for app) at row (top + 30) height 26 active false command paint rotate left command in ui)
        set row to row + (button (label "Rotate 90°" "90° draaien" for app) at row (top + 30) height 26 active false command paint rotate right command in ui)
        set widest to the maximum of widest and row
        set row to x
        set row to row + (button (label "Flip horizontal" "Horizontaal spiegelen" for app) at row (top + 60) height 26 active false command paint flip horizontal command in ui)
        set row to row + (button (label "Flip vertical" "Verticaal spiegelen" for app) at row (top + 60) height 26 active false command paint flip vertical command in ui)
        set widest to the maximum of widest and row
        set x to close group (label "Image" "Afbeelding" for app) from start to widest in ui
        set start to x
        set row to x
        set row to row + (button (label "Grayscale" "Grijswaarden" for app) at row top height 26 active false command paint grayscale command in ui)
        set row to row + (button (label "Invert colors" "Kleuren omkeren" for app) at row top height 26 active false command paint invert command in ui)
        set row to row + (button (label "Sepia" "Sepia" for app) at row top height 26 active false command paint sepia command in ui)
        set widest to row
        ignore a stepper (label "Brightness" "Helderheid" for app) showing (the string form of "±10") at (widest + 8) top lowering paint darker command raising paint brighter command in ui
        ignore a stepper (label "Contrast" "Contrast" for app) showing (the string form of "±10") at (widest + 8) (top + 30) lowering paint less contrast command raising paint more contrast command in ui
        ignore a stepper (label "Saturation" "Verzadiging" for app) showing (the string form of "±20 %") at (widest + 8) (top + 60) lowering paint less saturation command raising paint more saturation command in ui
        set x to close group (label "Adjustments" "Kleurcorrecties" for app) from start to (widest + 204) in ui
        set start to x
        ignore button (label "Clear canvas" "Canvas wissen" for app) at x top height 26 active false command paint clear command in ui
        ignore close group (label "Canvas" "Canvas" for app) from start to (x + 120) in ui

function draw the view ribbon of {paint app:app} in {a pointer to a paint ui:ui}:
    execute:
        set top to (paint title height + paint tab height) + 6
        set x to 16
        set start to x
        set row to x
        set row to row + (button (the string form of "−") at row top height 26 active false command paint zoom out command in ui)
        set row to row + (button (the percent ((the rounded value of (app's zoom * 100.0)) as an integer)) at row top height 26 active false command paint actual size command in ui)
        set row to row + (button (the string form of "+") at row top height 26 active false command paint zoom in command in ui)
        set widest to row
        set row to x
        set row to row + (button (label "Fit to window" "Passend maken" for app) at row (top + 30) height 26 active false command paint fit command in ui)
        set row to row + (button (label "Actual size" "Ware grootte" for app) at row (top + 30) height 26 active false command paint actual size command in ui)
        set widest to the maximum of widest and row
        set row to x
        set row to row + (button (label "Grid" "Raster" for app) at row (top + 60) height 26 active app's grid command paint grid command in ui)
        set row to row + (button (label "Focus mode" "Focusmodus" for app) at row (top + 60) height 26 active app's focus command paint focus command in ui)
        set widest to the maximum of widest and row
        set x to close group (label "Zoom" "Zoom" for app) from start to widest in ui
        set start to x
        set themeCaption to (label "Theme: " "Thema: " for app) + (the name of theme app's theme for app)
        set row to x + (button themeCaption at x top height 26 active false command paint theme command in ui)
        set language to the string form of "Language: English"
        if app's dutch:
            set language to the string form of "Taal: Nederlands"
        set row to the maximum of row and (x + (button language at x (top + 30) height 26 active false command paint language command in ui))
        ignore close group (label "Settings" "Instellingen" for app) from start to row in ui

function draw the file ribbon of {paint app:app} in {a pointer to a paint ui:ui}:
    execute:
        set top to (paint title height + paint tab height) + 6
        set x to 16
        set start to x
        set x to x + (large button (label "New canvas" "Nieuw canvas" for app) marked "＋" at x top command paint new command in ui)
        set x to x + (large button (label "Open" "Openen" for app) marked "▤" at x top command paint open command in ui)
        set x to x + (large button (label "Save" "Opslaan" for app) marked "▣" at x top command paint save command in ui)
        set x to x + (large button (label "Save as" "Opslaan als" for app) marked "⇩" at x top command paint save as command in ui)
        set x to close group (label "Project" "Project" for app) from start to x in ui
        set hint to label "PNG keeps transparency; BMP and PPM are flattened on white." "PNG behoudt transparantie; BMP en PPM worden op wit platgemaakt." for app
        show hint at x (top + 40) sized 12 in ui's theme's muted in ui

function draw the ribbon of {paint app:app} {integer:width} in {a pointer to a paint ui:ui}:
    execute:
        set top to paint title height + paint tab height
        fill 0 top width paint ribbon height with ui's theme's bar in ui
        fill 0 ((top + paint ribbon height) - 1) width 1 with ui's theme's border in ui
        if app's tab = paint image tab:
            draw the image ribbon of app in ui
        else if app's tab = paint view tab:
            draw the view ribbon of app in ui
        else if app's tab = 3:
            draw the file ribbon of app in ui
        else:
            draw the home ribbon of app in ui

function draw the panel of {paint app:app} {integer:width} {integer:height} in {a pointer to a paint ui:ui}:
    execute:
        set theme to ui's theme
        set left to width - paint panel width
        set top to the workspace top for app
        set bottom to height - paint status height
        fill left top paint panel width (bottom - top) with theme's bar in ui
        fill left top 1 (bottom - top) with theme's border in ui
        set x to left + 18
        show (label "Properties" "Eigenschappen" for app) at x (top + 26) sized 13 in theme's text in ui
        fill left (top + 42) paint panel width 1 with theme's border in ui
        show (label "Canvas" "Canvas" for app) at x (top + 70) sized 13 in theme's text in ui
        show (label "Width" "Breedte" for app) at x (top + 92) sized 10 in theme's muted in ui
        show (label "Height" "Hoogte" for app) at (x + 120) (top + 92) sized 10 in theme's muted in ui
        show (the string form of app's image's width) at x (top + 116) sized 17 in theme's text in ui
        show (the string form of app's image's height) at (x + 120) (top + 116) sized 17 in theme's text in ui
        show "px" at (x + 52) (top + 116) sized 10 in theme's muted in ui
        show "px" at (x + 172) (top + 116) sized 10 in theme's muted in ui
        show (label "Tool" "Gereedschap" for app) at x (top + 146) sized 10 in theme's muted in ui
        show (the name of tool app's tool for app) at x (top + 166) sized 13 in theme's text in ui
        fill (x + 120) (top + 152) 18 18 with app's color in ui
        outline (x + 120) (top + 152) 18 18 with theme's border in ui
        fill left (top + 186) paint panel width 1 with theme's border in ui
        show (label "History" "Geschiedenis" for app) at x (top + 214) sized 13 in theme's text in ui
        set count to the length of app's history's undo
        set badge to the string form of count
        set badgeWidth to (the width of badge sized 11 in ui) + 12
        outline ((left + paint panel width) - (badgeWidth + 18)) (top + 200) badgeWidth 20 with theme's border in ui
        show badge at ((left + paint panel width) - (badgeWidth + 12)) (top + 214) sized 11 in theme's text in ui
        set steps to app's steps
        if (the length of steps) = 0:
            show (label "Your next idea starts here." "Hier begint je volgende idee." for app) at x (top + 250) sized 12 in theme's muted in ui
            ignore show (label "Choose a tool and draw on the canvas." "Kies een gereedschap en teken op het canvas." for app) wrapped to (paint panel width - 36) at x (top + 272) sized 11 in theme's muted in ui
        set y to top + 236
        set index to (the length of steps) - 1
        loop while (index >= 0) and ((y + 32) < (bottom - 70)):
            if index = ((the length of steps) - 1):
                fill (left + 8) y (paint panel width - 16) 30 with theme's active in ui
            show ((index + 1) padded to 2 digits) at x (y + 20) sized 11 in theme's muted in ui
            show (the item at index in steps) at (x + 28) (y + 20) sized 12 in theme's text in ui
            set y to y + 32
            set index to index - 1
        fill left (bottom - 62) paint panel width 1 with theme's border in ui
        fill x (bottom - 44) 22 22 with theme's accent in ui
        show "Own your tools." at (x + 34) (bottom - 36) sized 12 in theme's text in ui
        show "OpenAEC Foundation" at (x + 34) (bottom - 20) sized 10 in theme's muted in ui

function draw the status bar of {paint app:app} {integer:width} {integer:height} at {integer:column} {integer:row} inside {boolean:inside} in {a pointer to a paint ui:ui}:
    execute:
        set theme to ui's theme
        set top to height - paint status height
        set light to the paint color from hex "fafaf9"
        fill 0 top width paint status height with theme's title in ui
        fill 14 (top + 12) 6 6 with (the paint color from hex "16a34a") in ui
        set message to app's message
        if message's length = 0:
            set message to label "Ready to draw" "Klaar om te tekenen" for app
            if app's tool = paint text tool:
                set message to label "Click the canvas to place your text; Enter applies it." "Klik op het canvas om je tekst te plaatsen; Enter past hem toe." for app
            if app's tool = paint crop tool:
                set message to label "Drag a rectangle to crop the image. Undo restores the original." "Sleep een rechthoek om de afbeelding bij te snijden. Ongedaan maken herstelt het origineel." for app
        show message at 28 (top + 19) sized 11 in light in ui
        if inside:
            set position to (((the string form of column) + (the string form of ", ")) + (the string form of row)) + (the string form of " px")
            show position at 520 (top + 19) sized 11 in light in ui
        set zoomText to the percent ((the rounded value of (app's zoom * 100.0)) as an integer)
        set right to width - 16
        show zoomText at (right - 40) (top + 19) sized 11 in light in ui
        set plus to (right - 70)
        if ui hovers plus top 24 paint status height:
            fill plus (top + 4) 24 20 with (theme's title mixed with light at 15) in ui
        show "+" at (plus + 8) (top + 19) sized 13 in light in ui
        if ui's clicked and (ui hovers plus top 24 paint status height):
            set ui's command to paint zoom in command
        set minus to (right - 98)
        if ui hovers minus top 24 paint status height:
            fill minus (top + 4) 24 20 with (theme's title mixed with light at 15) in ui
        show "−" at (minus + 8) (top + 19) sized 13 in light in ui
        if ui's clicked and (ui hovers minus top 24 paint status height):
            set ui's command to paint zoom out command
        set toolName to the name of tool app's tool for app
        show toolName at ((minus - 20) - (the width of toolName sized 11 in ui)) (top + 19) sized 11 in light in ui

# --- The workspace and the canvas ---

# Composes the canvas over the transparency checkerboard into display, an
# opaque RGBA buffer of the same size that the canvas texture shows, in
# linear light (see the linear channel above).
function compose {paint canvas:image} into display {pointer:display}:
    execute:
        set table to @intrinsic("call", "libc", "malloc", a pointer to a byte, 256 as a word sized integer)
        loop level from 0 to 256:
            store ((the linear channel of level) as a byte) at (table + level)
        set pixels to image's pixels
        loop row from 0 to image's height:
            loop column from 0 to image's width:
                set offset to ((row * image's width) + column) * 4
                set alpha to ((the item at (offset + 3) in pixels) as an integer) & 255
                set checker to 255
                if (the remainder of ((column / 8) + (row / 8)) divided by 2) = 1:
                    set checker to 229
                set kept to 255 - alpha
                loop channel from 0 to 3:
                    set level to ((the item at (offset + channel) in pixels) as an integer) & 255
                    if alpha != 255:
                        set level to ((level * alpha) + (checker * kept)) / 255
                    store (the item at level in table) at (display + (offset + channel))
                store (255 as a byte) at (display + (offset + 3))
        @intrinsic("call", "libc", "free", nothing, table)

function draw the workspace of {paint app:app} showing {graphics texture:texture} {integer:width} {integer:height} in {a pointer to a paint ui:ui}:
    execute:
        set theme to ui's theme
        set top to the workspace top for app
        set right to the workspace right of width for app
        set bottom to height - paint status height
        fill 0 top right (bottom - top) with theme's workspace in ui
        set zoom to app's zoom
        set left to app's panX
        set upper to (top as a 64 bit floating-point number) + app's panY
        set shown to (app's image's width as a 64 bit floating-point number) * zoom
        set tall to (app's image's height as a 64 bit floating-point number) * zoom
        fill ((left as an integer) + 4) ((upper as an integer) + 4) (shown as an integer) (tall as an integer) with (theme's workspace mixed with (the paint color from hex "000000") at 18) in ui
        if texture is loaded:
            draw texture from x left, y upper to x (left + shown), y (upper + tall) in color red 255, green 255 and blue 255 in ui's frame
        if app's grid and (zoom >= 6.0):
            set gridColor to the paint color from hex "c8c8c8"
            loop column from 0 to (app's image's width + 1):
                set gx to left + ((column as a 64 bit floating-point number) * zoom)
                if (gx >= 0.0) and (gx <= (right as a 64 bit floating-point number)):
                    fill (gx as an integer) (the maximum of (upper as an integer) and top) 1 (tall as an integer) with gridColor in ui
            loop row from 0 to (app's image's height + 1):
                set gy to upper + ((row as a 64 bit floating-point number) * zoom)
                if (gy >= (top as a 64 bit floating-point number)) and (gy <= (bottom as a 64 bit floating-point number)):
                    fill (the maximum of (left as an integer) and 0) (gy as an integer) (shown as an integer) 1 with gridColor in ui
        if app's dragging and (app's tool = paint crop tool):
            set cx to left + ((the minimum of app's startX and app's lastX) * zoom)
            set cy to upper + ((the minimum of app's startY and app's lastY) * zoom)
            set cw to (the absolute value of (app's lastX - app's startX)) * zoom
            set ch to (the absolute value of (app's lastY - app's startY)) * zoom
            outline (cx as an integer) (cy as an integer) (cw as an integer) (ch as an integer) with theme's accent in ui
            outline ((cx as an integer) + 1) ((cy as an integer) + 1) ((cw as an integer) - 2) ((ch as an integer) - 2) with (the paint color from hex "ffffff") in ui
        if app's typing:
            use ui's typeface at app's textSize pixel size
            set advance to the width of app's typed in ui's typeface
            set caretX to left + (((app's textX + advance) as a 64 bit floating-point number) * zoom)
            set caretTop to upper + (((app's textY - app's textSize) as a 64 bit floating-point number) * zoom)
            fill ((caretX as an integer) + 1) (caretTop as an integer) 2 (((app's textSize as a 64 bit floating-point number) * zoom) as an integer) with theme's accent in ui
        set sizeText to ((the string form of app's image's width) + (the string form of " × ")) + ((the string form of app's image's height) + (the string form of " px"))
        show sizeText at ((right - (the width of sizeText sized 11 in ui)) - 16) (bottom - 10) sized 11 in theme's muted in ui

function draw {paint app:app} showing {graphics texture:texture} {integer:width} {integer:height} at {integer:column} {integer:row} inside {boolean:inside} in {a pointer to a paint ui:ui}:
    execute:
        draw the workspace of app showing texture width height in ui
        if app's focus = false:
            draw the panel of app width height in ui
            draw the ribbon of app width in ui
            draw the tabs of app width in ui
        draw the title bar of app width in ui
        draw the status bar of app width height at column row inside inside in ui
